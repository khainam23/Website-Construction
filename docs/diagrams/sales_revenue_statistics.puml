@startuml Sales Revenue Statistics

title Quy Trình Xem Thống Kê Doanh Thu

actor "Sale Staff" as SaleStaff
participant "Giao Diện\nRevenue Statistics" as RevenueUI
participant "RevenueController" as RevenueCtrl
database "Database" as DB
participant "Order Model" as OrderModel
participant "OrderDetail Model" as OrderDetailModel
participant "Chart.js" as ChartJS

== Xem Thống Kê Doanh Thu ==

SaleStaff -> RevenueUI: Truy cập trang thống kê doanh thu
activate RevenueUI

RevenueUI -> RevenueCtrl: index(Request $request)
activate RevenueCtrl

RevenueCtrl -> RevenueCtrl: Xác định khoảng thời gian
note right: Mặc định hoặc từ request

RevenueCtrl -> RevenueCtrl: getDailyRevenue()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: whereBetween('created_at', [$startDate, $endDate])
activate OrderDetailModel
OrderDetailModel -> DB: SELECT DATE_FORMAT(created_at, '%Y-%m-%d') as date,\nSUM(cost * quantity) as revenue\nFROM order_details\nWHERE created_at BETWEEN ? AND ?\nGROUP BY date
DB --> OrderDetailModel: Doanh thu theo ngày
OrderDetailModel --> RevenueCtrl: Dữ liệu doanh thu theo ngày
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getWeeklyRevenue()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: whereBetween('created_at', [$startDate, $endDate])
activate OrderDetailModel
OrderDetailModel -> DB: SELECT CONCAT(YEAR(created_at), '-', WEEK(created_at)) as week,\nDATE_FORMAT(MIN(created_at), '%Y-%m-%d') as start_date,\nDATE_FORMAT(MAX(created_at), '%Y-%m-%d') as end_date,\nSUM(cost * quantity) as revenue\nFROM order_details\nWHERE created_at BETWEEN ? AND ?\nGROUP BY week
DB --> OrderDetailModel: Doanh thu theo tuần
OrderDetailModel --> RevenueCtrl: Dữ liệu doanh thu theo tuần
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getCombinedMonthlyRevenue()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: Lấy doanh thu cho từng loại (thuê và bán)
activate OrderDetailModel
OrderDetailModel -> DB: SELECT DATE_FORMAT(created_at, '%Y-%m') as month,\nSUM(cost * quantity) as revenue\nFROM order_details\nWHERE created_at BETWEEN ? AND ?\nAND rental_start_date IS NULL/NOT NULL\nGROUP BY month
DB --> OrderDetailModel: Doanh thu theo tháng
OrderDetailModel --> RevenueCtrl: Dữ liệu doanh thu theo tháng
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getCombinedYearlyRevenue()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: Lấy doanh thu cho từng loại (thuê và bán)
activate OrderDetailModel
OrderDetailModel -> DB: SELECT DATE_FORMAT(created_at, '%Y') as year,\nSUM(cost * quantity) as revenue\nFROM order_details\nWHERE created_at BETWEEN ? AND ?\nAND rental_start_date IS NULL/NOT NULL\nGROUP BY year
DB --> OrderDetailModel: Doanh thu theo năm
OrderDetailModel --> RevenueCtrl: Dữ liệu doanh thu theo năm
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getSummaryStatistics()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: Tính tổng doanh thu, doanh thu bán, doanh thu thuê
activate OrderDetailModel
OrderDetailModel -> DB: Các truy vấn thống kê tổng hợp
DB --> OrderDetailModel: Kết quả thống kê
OrderDetailModel --> RevenueCtrl: Dữ liệu thống kê
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getTopSellingProducts()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: join('products')
activate OrderDetailModel
OrderDetailModel -> DB: SELECT products.name, SUM(quantity) as total_quantity,\nSUM(cost * quantity) as total_revenue\nFROM order_details JOIN products\nGROUP BY products.id, products.name\nORDER BY total_quantity DESC\nLIMIT ?
DB --> OrderDetailModel: Danh sách sản phẩm bán chạy
OrderDetailModel --> RevenueCtrl: Dữ liệu sản phẩm bán chạy
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl -> RevenueCtrl: getRevenueByCategory()
activate RevenueCtrl
RevenueCtrl -> OrderDetailModel: join('products'), join('categories')
activate OrderDetailModel
OrderDetailModel -> DB: SELECT categories.name, SUM(cost * quantity) as total_revenue\nFROM order_details\nJOIN products ON order_details.product_id = products.id\nJOIN categories ON products.category_id = categories.id\nWHERE order_details.created_at BETWEEN ? AND ?\nGROUP BY categories.id, categories.name
DB --> OrderDetailModel: Doanh thu theo danh mục
OrderDetailModel --> RevenueCtrl: Dữ liệu doanh thu theo danh mục
deactivate OrderDetailModel
deactivate RevenueCtrl

RevenueCtrl --> RevenueUI: Trả về view với dữ liệu thống kê đầy đủ
deactivate RevenueCtrl

RevenueUI -> ChartJS: Khởi tạo các biểu đồ thống kê
activate ChartJS
ChartJS --> RevenueUI: Hiển thị biểu đồ
deactivate ChartJS

RevenueUI --> SaleStaff: Hiển thị trang thống kê doanh thu
deactivate RevenueUI

@enduml
