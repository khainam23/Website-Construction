@startuml Sơ Đồ Trình Tự Đăng Ký

title Quy Trình Đăng Ký

actor "Người Dùng" as User
participant "Giao Diện\nTrang Đăng Ký" as FrontendRegister
participant "Yêu Cầu AJAX" as Ajax
participant "Bộ Điều Khiển Đăng Ký" as RegisterController
participant "Mô Hình Người Dùng" as UserModel
database "Cơ Sở Dữ Liệu" as DB
participant "Dịch Vụ Email" as EmailService

User -> FrontendRegister : Mở trang đăng ký
FrontendRegister -> FrontendRegister : Hiển thị form đăng ký

User -> FrontendRegister : Điền thông tin đăng ký
User -> FrontendRegister : Nhấn nút Đăng ký

activate FrontendRegister
FrontendRegister -> FrontendRegister : Kiểm tra dữ liệu phía client (định dạng SĐT, v.v.)

alt Kiểm tra client thất bại
    FrontendRegister --> User : Hiển thị lỗi xác thực
else Kiểm tra client thành công
    FrontendRegister -> Ajax : Gửi dữ liệu form qua AJAX
    activate Ajax
    
    Ajax -> RegisterController : POST /api/register
    activate RegisterController
    
    RegisterController -> RegisterController : Xác thực dữ liệu phía server
    
    alt Xác thực server thất bại
        RegisterController --> Ajax : Trả về lỗi xác thực
        Ajax --> FrontendRegister : Hiển thị lỗi xác thực
    else Xác thực server thành công
        
        alt Có upload ảnh đại diện
            RegisterController -> RegisterController : Xử lý và lưu ảnh đại diện
        end
        
        RegisterController -> UserModel : Tạo người dùng mới
        activate UserModel
        UserModel -> DB : Thêm bản ghi người dùng mới
        activate DB
        DB --> UserModel : Người dùng đã được tạo
        deactivate DB
        
        UserModel --> RegisterController : Trả về thông tin người dùng đã tạo
        deactivate UserModel
        
        RegisterController -> EmailService : Gửi email xác thực
        activate EmailService
        EmailService --> RegisterController : Email đã được gửi
        deactivate EmailService
        
        RegisterController --> Ajax : Trả về phản hồi thành công
        deactivate RegisterController
        
        Ajax --> FrontendRegister : Hiển thị thông báo thành công
        deactivate Ajax
        
        FrontendRegister --> User : Hiển thị thông báo chuyển hướng đến đăng nhập
        FrontendRegister -> FrontendRegister : Chuyển hướng đến trang đăng nhập
    end
end

deactivate FrontendRegister

@enduml
